---
import '../styles/global.css';

const { title, description, pubDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} - Crescendo Engine</title>
        <meta name="description" content={description} />
    </head>
    <body>
        <canvas id="shader-canvas"></canvas>
        
        <article class="post-container">
            <a href="/crescendo" style="color: #8b949e; text-decoration: none; display: inline-block; margin-bottom: 2rem;">&larr; Back to Devlog</a>
            
            {heroImage && <img src={heroImage} alt="" class="hero-image" />}
            
            <h1 class="post-title">{title}</h1>
            <p class="post-date">
                {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            
            <hr class="divider" />
            
            <div class="post-content">
                <slot /> </div>
        </article>
    </body>
</html>

<style>
    /* 1. Widen the container to support two columns comfortably */
    .post-container {
        max-width: 1200px; /* Upgraded from 800px */
        margin: 0 auto;
        padding: 4rem 2rem;
        background-color: transparent;
    }
    
    .hero-image {
        width: 100%;
        border-radius: 8px;
        margin-bottom: 2rem;
    }
    .post-title {
        font-size: 2.5rem;
        color: #d1893d; /* Keeping your new orange accent! */
        margin: 0 0 0.5rem 0;
    }
    .post-date {
        color: #8b949e;
        margin: 0 0 2rem 0;
    }
    .divider {
        border: 0;
        border-top: 1px solid #30363d;
        margin-bottom: 2rem;
    }
    .post-content {
        line-height: 1.8;
        font-size: 1.1rem;
        color: #c9d1d9;
    }

    /* Base styling & Mobile Stack (Default) */
    .post-content :global(h2) { color: #fff; margin-top: 2rem; }
    .post-content :global(h3) { color: #fff; margin-top: 1.5rem; }
    .post-content :global(pre) { background: #161b22; padding: 1rem; border-radius: 6px; overflow-x: auto; border: 1px solid #30363d; margin-bottom: 1.5rem; }
    .post-content :global(code) { font-family: monospace; background: #21262d; padding: 0.2rem 0.4rem; border-radius: 3px; }
    .post-content :global(p) { margin-bottom: 1.5rem; }
    
    .post-content :global(img),
    .post-content :global(iframe) {
        width: 100%;
        border-radius: 6px;
        border: 1px solid #30363d;
        margin: 2rem 0;
        display: block;
    }
    .post-content :global(iframe) {
        aspect-ratio: 16 / 9;
    }

    /* 2. The Magic Split (Desktop Only) */
    @media (min-width: 1024px) {
        .post-content {
            display: grid;
            /* The Asymmetrical Split: Text gets 1 fraction, Media gets 1.5 fractions */
            grid-template-columns: 1fr 1.6fr; 
            column-gap: 4rem; /* Tightened the gap so they sit closer together */
            grid-auto-flow: dense;
            align-items: start;
        }

        /* Lock all text/code to the LEFT column */
        .post-content :global(p),
        .post-content :global(h2),
        .post-content :global(h3),
        .post-content :global(ul),
        .post-content :global(ol),
        .post-content :global(pre) {
            grid-column: 1;
            margin-top: 0; 
        }

        /* Lock all media to the RIGHT column */
        .post-content :global(img),
        .post-content :global(iframe),
        .post-content :global(video) {
            grid-column: 2;
            margin-top: 0; 
        }
    }
</style>