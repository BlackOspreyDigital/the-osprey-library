---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={`${title} | The Osprey Library`} description={description}>
  <div class="doc-container">
    <aside class="sidebar">
      <nav class="sidebar-nav">
        <div class="nav-group">
          <h3>Crescendo Renderer</h3>
          <ul>
            <li><a href="/crescendo/engine-init">Engine Initialization</a></li>
            <li><a href="/crescendo/principle-shader">Principle Implementation</a></li>
            <li><a href="/crescendo/octree-ssbo">Octree & SSBO Architecture</a></li>
            <li><a href="/crescendo/voxels">Voxel Systems</a></li>
          </ul>
        </div>
        <div class="nav-group">
          <h3>Physics Subsystems</h3>
          <ul>
            <li><a href="/crescendo/jolt-integration">Jolt Physics Integration</a></li>
            <li><a href="/crescendo/vehicle-dynamics">Vehicle Dynamics</a></li>
          </ul>
        </div>
      </nav>
    </aside>

    <main class="doc-content">
      <article class="prose">
        <header class="doc-header">
          <h1>{title}</h1>
          <p class="lead">{description}</p>
        </header>
        <div class="markdown-body">
          <slot />
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .doc-container {
    display: flex;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    flex: 1;
  }

  .sidebar {
    width: 280px;
    border-right: 1px solid var(--border-color);
    padding: 2rem;
    flex-shrink: 0;
    background: var(--bg-color);
  }

  .nav-group h3 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .nav-group ul {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
  }

  .nav-group li {
    margin-bottom: 0.5rem;
  }

  .nav-group a {
    color: var(--text-main);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav-group a:hover {
    color: var(--accent);
  }

  .doc-content {
    flex: 1;
    padding: 3rem 4rem;
    min-width: 0;
  }

  .prose {
    max-width: 800px;
  }

  .doc-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }

  .doc-header h1 {
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
  }

  .lead {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Markdown Content Styling */
  .markdown-body :global(h2) {
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .markdown-body :global(h3) {
    font-size: 1.25rem;
    margin-top: 2rem;
  }

  .markdown-body :global(p) {
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #cbd5e1;
  }

  .markdown-body :global(pre) {
    background: #111318;
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .markdown-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  .markdown-body :global(p > code) {
    background: #1e2128;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: var(--accent);
  }
</style>