---
// src/pages/index.astro
import '../styles/global.css';

// Build-time TeamSpeak 6 status fetch
const TS_API_URL = "http://YOUR_VPS_IP:PORT/api/status"; 
let tsStatus = "Status Unavailable";
let isOnline = false;

try {
    const response = await fetch(TS_API_URL);
    if (response.ok) {
        const data = await response.json();
        isOnline = data.online; 
        tsStatus = isOnline ? `Online - ${data.clients_online} connected` : "Offline";
    }
} catch (error) {
    console.error("Failed to fetch TeamSpeak status during build:", error);
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>The Osprey Library - Crescendo Engine</title>
        <meta name="description" content="Development Hub for the Crescendo Engine" />
    </head>
    <body>
        <canvas id="shader-canvas"></canvas>

        <main class="landing-container">
            <header>
                <h1>The Osprey Library</h1>
                <p>Development Hub for the Crescendo Engine</p>
            </header>

            <nav class="primary-nav">
                <a href="/crescendo" class="nav-link">Devlog & Tech Demos</a>
                <a href="/docs" class="nav-link">Documentation</a>
                <a href="/contribute" class="nav-link">Help Us Build</a>
                <a href="/license" class="nav-link">License</a>
            </nav>

            <div class="community-section">
                <a href="/status" class="community-button">
                    <span class={isOnline ? "indicator online" : "indicator offline"}></span>
                    TeamSpeak 6 Access: {tsStatus}
                </a>
            </div>

            <footer class="external-links">
                <a href="https://github.com/YOUR_HANDLE" target="_blank" rel="noopener noreferrer">GitHub</a>
                <a href="https://x.com/YOUR_HANDLE" target="_blank" rel="noopener noreferrer">X</a>
            </footer>
        </main>
    </body>
</html>