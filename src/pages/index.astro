---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Osprey Library</title>
</head>
<body class="hub-body">
    <main class="hub-container">
        <h1 class="hub-title">THE OSPREY LIBRARY</h1>
        <p class="hub-subtitle">Development Hub for the Crescendo Engine</p>

        <div class="button-grid">
            <a href="/crescendo/" class="hub-btn">Devlog & Tech Demos</a>
            <a href="/docs/" class="hub-btn">Documentation</a>
            <a href="/contribute/" class="hub-btn">Help Us Build</a>
            <a href="/license/" class="hub-btn">License</a>
        </div>

        <a href="https://forum.theospreylibrary.com" class="forum-thumb-btn">
            <img src="/images/forum.png" alt="Osprey Library Community Forum" />
        </a>

    </main>
</body>
</html>

<style>
    .hub-body {
        background-color: #0d1117;
        color: #c9d1d9;
        font-family: system-ui, -apple-system, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
    }
    .hub-container {
        text-align: center;
        max-width: 800px;
        padding: 2rem;
    }
    .hub-title {
        color: #d1893d;
        font-size: 3.5rem;
        margin: 0;
        font-weight: 700;
        letter-spacing: -0.5px;
    }
    .hub-subtitle {
        color: #8b949e;
        font-size: 1.1rem;
        margin-top: 1rem;
        margin-bottom: 3rem;
    }
    .button-grid {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
    }
    .hub-btn {
        background: transparent;
        color: #c9d1d9;
        border: 1px solid #30363d;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.95rem;
        transition: background 0.2s ease, border-color 0.2s ease;
    }
    .hub-btn:hover {
        background: #161b22;
        border-color: #8b949e;
    }
    .ts-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background: #21262d;
        color: #e6edf3;
        border: 1px solid #30363d;
        padding: 0.75rem 2rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 3.5rem;
        transition: background 0.2s ease;
    }
    .ts-btn:hover {
        background: #30363d;
    }
    .status-dot {
        width: 10px;
        height: 10px;
        background-color: #238636;
        border-radius: 50%;
        box-shadow: 0 0 10px rgba(35, 134, 54, 0.6);
    }
    .social-links {
        display: flex;
        justify-content: center;
        gap: 2rem;
    }
    .social-links a {
        color: #8b949e;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s ease;
    }
    .social-links a:hover {
        color: #d1893d;
    }
</style is:global>