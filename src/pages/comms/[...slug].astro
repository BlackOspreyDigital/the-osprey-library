---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const commsEntries = await getCollection('comms');
  return commsEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={`${entry.data.title} | Comms`} description={entry.data.description}>
  <article class="post-container">
    <header class="post-header">
      <time datetime={entry.data.pubDate.toISOString()}>
        {entry.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
      <h1>{entry.data.title}</h1>
    </header>
    <div class="markdown-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
    flex: 1;
  }

  .post-header {
    margin-bottom: 3rem;
    text-align: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 3rem;
  }

  .post-header time {
    display: block;
    color: var(--accent);
    margin-bottom: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .post-header h1 {
    font-size: 3rem;
    margin: 0;
    line-height: 1.2;
  }

  /* Reuse the markdown styling from DocLayout for consistency */
  .markdown-body :global(h2) {
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .markdown-body :global(p) {
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: #cbd5e1;
    font-size: 1.1rem;
  }

  .markdown-body :global(pre) {
    background: #111318;
    border: 1px solid var(--border-color);
    padding: 1.25rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .markdown-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  .markdown-body :global(p > code) {
    background: #1e2128;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    color: var(--accent);
  }
</style>