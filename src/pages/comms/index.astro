---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allComms = await getCollection('comms');

const sortedComms = allComms.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout 
  title="Comms | The Osprey Library" 
  description="Announcements, devlogs, and general comms."
>
  <main class="comms-container">
    <header class="comms-header">
      <h1>Comms Feed</h1>
      <p>Library updates, development logs, and general announcements.</p>
    </header>

    <div class="comms-list">
      {sortedComms.map((post) => (
        <article class="comm-card">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
          </time>
          <h2><a href={`/comms/${post.id}`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          <a href={`/comms/${post.id}`} class="read-more">Read Entry &rarr;</a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .comms-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
    flex: 1;
  }

  .comms-header {
    margin-bottom: 4rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }

  .comms-header h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem 0;
  }

  .comms-header p {
    color: var(--text-muted);
    font-size: 1.2rem;
    margin: 0;
  }

  .comms-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .comm-card time {
    display: block;
    font-size: 0.875rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .comm-card h2 {
    font-size: 1.75rem;
    margin: 0 0 1rem 0;
  }

  .comm-card h2 a {
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .comm-card h2 a:hover {
    color: var(--accent);
  }

  .comm-card p {
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .read-more {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.2s ease;
  }

  .read-more:hover {
    border-color: var(--accent);
  }
</style>