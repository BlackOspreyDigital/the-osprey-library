---
// src/pages/crescendo/index.astro
import { getCollection } from 'astro:content';
import '../../styles/global.css';

// Fetch all devlog posts and sort them newest to oldest
const posts = (await getCollection('crescendo')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Crescendo Engine Devlog</title>
    </head>
    <body>
        <canvas id="shader-canvas"></canvas>

        <main class="landing-container" style="max-width: 1200px;">
            <header style="margin-bottom: 4rem;">
                <h1>Crescendo Engine Devlog</h1>
                <p>Architecture notes, rendering updates, and tech demos.</p>
                <a href="/" class="nav-link" style="display: inline-block; margin-top: 1rem;">&larr; Back to Hub</a>
            </header>

            <div class="devlog-grid">
                {posts.map((post) => (
                    <a href={`/crescendo/${post.slug}/`} class="grid-tile">
                        {post.data.heroImage && (
                            <img src={post.data.heroImage} alt="" class="tile-image" />
                        )}
                        <h2 class="tile-title">{post.data.title}</h2>
                        <p class="tile-date">
                            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                        </p>
                        <p class="tile-desc">{post.data.description}</p>
                    </a>
                ))}
            </div>
        </main>
    </body>
</html>

<style>
    .devlog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        text-align: left;
    }
    .grid-tile {
        background: #161b22;
        border: 1px solid #30363d;
        padding: 2rem;
        border-radius: 6px;
        text-decoration: none;
        color: inherit;
        transition: transform 0.15s ease-out, border-color 0.15s ease-out;
        display: flex;
        flex-direction: column;
    }
    .grid-tile:hover {
        transform: translateY(-4px);
        border-color: #8b949e;
    }
    .tile-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 4px;
        margin-bottom: 1.5rem;
    }
    .tile-title {
        margin: 0 0 0.5rem 0;
        font-size: 1.5rem;
        color: #58a6ff;
    }
    .tile-date {
        margin: 0 0 1rem 0;
        font-size: 0.9rem;
        color: #8b949e;
    }
    .tile-desc {
        margin: 0;
        color: #c9d1d9;
        line-height: 1.5;
    }
</style>