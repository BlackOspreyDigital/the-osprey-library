---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout>
    <div class="contact-wrapper">
        <header class="contact-header">
            <h1>CONTACT</h1>
            <h2>COMMUNITY GUIDELINE</h2>
            <p>Get involved!</p>
            <p>Access our online communities</p>
        </header>

        <div class="contact-interactive">
            
            <a href="#" class="ts-badge">
                <span class="status-dot"></span>
                ts.theospreylibrary.com : Online
            </a>

            <div class="social-grid">
                <a href="#" target="_blank" rel="noopener noreferrer">
                    <img src="/images/brandings/teamspeak.png" alt="TeamSpeak" />
                </a>
                <a href="https://github.com/BlackOspreyDigital" target="_blank" rel="noopener noreferrer">
                    <img src="/images/brandings/github.webp" alt="GitHub" />
                </a>
                <a href="mailto:your@email.com">
                    <img src="/images/brandings/email.webp" alt="Email" />
                </a>
                <a href="https://x.com/Android_NI93" target="_blank" rel="noopener noreferrer">
                    <img src="/images/brandings/X_logo_2023_(white).png" alt="X" />
                </a>
            </div>
            
        </div>
    </div>
</SiteLayout>

<style>
    /* Container aligns everything to the left as per the red arrow */
    .contact-wrapper {
        max-width: 900px;
        display: flex;
        flex-direction: column;
        align-items: flex-start; 
    }

    /* Typography */
    .contact-header {
        margin-bottom: 4rem;
    }
    .contact-header h1 {
        font-size: 3rem;
        color: #ffffff;
        margin: 0 0 0.5rem 0;
    }
    .contact-header h2 {
        font-size: 1.1rem;
        color: #8b949e;
        text-transform: uppercase;
        margin: 0 0 2rem 0;
        font-weight: 500;
        letter-spacing: 1px;
    }
    .contact-header p {
        color: #c9d1d9;
        font-size: 1.1rem;
        margin: 0 0 0.5rem 0;
    }

    /* Interactive Section Layout */
    .contact-interactive {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 5rem; /* Pushes the badge and the icons apart */
    }

    /* TeamSpeak Status Pill */
    .ts-badge {
        display: inline-flex;
        align-items: center;
        gap: 1rem;
        background-color: #161b22;
        border: 1px solid #30363d;
        padding: 1rem 2rem;
        border-radius: 8px;
        color: #c9d1d9;
        font-weight: bold;
        font-size: 1.1rem;
        text-decoration: none;
        transition: border-color 0.2s ease;
    }
    .ts-badge:hover {
        border-color: #58a6ff;
    }
    
    /* Glowing Green Dot */
    .status-dot {
        width: 12px;
        height: 12px;
        background-color: #238636;
        border-radius: 50%;
        box-shadow: 0 0 10px #238636;
    }

    /* Icon Grid Layout */
    .social-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        max-width: 400px; /* Forces the 3-top, 1-bottom wrap behavior */
        justify-content: center;
    }
    .social-grid a img {
        width: 90px;
        height: 90px;
        object-fit: contain;
        transition: transform 0.2s ease;
        /* Note: If your .png files are black, uncomment the line below to turn them white! */
        /* filter: brightness(0) invert(1); */
    }
    .social-grid a:hover img {
        transform: scale(1.1);
    }
</style>